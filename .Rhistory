#Combine Author and Date,
Chars <- Chars%>%filter(Author!="Tan", Author !="KAPUR")%>%mutate(Author=paste(Author, Year, sep = ", "))
#Separate Different Substances
Alcohol<-Chars%>%filter(str_detect(Substance,"a"))%>%select(1:9,starts_with("A_"))
Nicotine<-Chars%>%filter(str_detect(Substance,"n"))%>%select(1:9,starts_with("N_"))
Cocaine<-Chars%>%filter(str_detect(Substance,"c"))%>%select(1:9,starts_with("C_"))
Opioid<-Chars%>%filter(str_detect(Substance,"o"))%>%select(1:9,starts_with("O_"))
GSD<-Chars%>%filter(str_detect(Substance,"g"))%>%select(1:9,starts_with("G_"))
Generate_models<-function(df){
cases<-df%>%select(contains("_Cas_"))%>%rename_all(~ stringr::str_replace(., regex("^[A-Z]_[A-Za-z]+_", ignore_case = TRUE), ""))
controls<-df%>%select(contains("_Con_"))%>%rename_all(~ stringr::str_replace(., regex("^[A-Z]_[A-Za-z]+_", ignore_case = TRUE), ""))
Homozygote<-cbind(df%>%select(1:9),cases%>%transmute(Cas_event=GG, Cas_nevent=AA+GG),controls%>%transmute(Con_event=GG, Con_nevent=AA+GG))
Heterozygote<-cbind(df%>%select(1:9),cases%>%transmute(Cas_event=AG, Cas_nevent=AA+AG),controls%>%transmute(Con_event=AG, Con_nevent=AA+AG))
Dominant<-cbind(df%>%select(1:9),cases%>%transmute(Cas_event=AG+GG, Cas_nevent=AA+AG+GG),controls%>%transmute(Con_event=AG+GG, Con_nevent=AA+AG+GG))
Recessive<-cbind(df%>%select(1:9),cases%>%transmute(Cas_event=AA+AG, Cas_nevent=AA+AG+GG),controls%>%transmute(Con_event=AA+AG, Con_nevent=AA+AG+GG))
Contrast<-cbind(df%>%select(1:9),cases%>%transmute(Cas_event=2*AA+AG, Cas_nevent=2*(AA+AG+GG)),controls%>%transmute(Con_event=2*AA+AG, Con_nevent=2*(AA+AG+GG)))
ls<-list(
Homozygote,
Heterozygote,
Dominant,
Recessive,
Contrast
)
names(ls)<-(c("Homo",
"Hetero",
"Dominant",
"Recessive",
"Contrast"))
return (ls)
}
Substances<-list(Alcohol,Nicotine,Cocaine,Opioid,GSD)
Models=lapply(Substances, Generate_models)
names(Models)<-c("Alcohol","Nicotine","Cocaine","Opioid","GSD")
sub_ind<-1
mod_ind<-1
sup_ind<-1
for(sub in Models){
for(m.data in sub){
model.name<-paste(names(Models)[sub_ind],names(sub)[mod_ind],sep = "_")
if(nrow(m.data)<10){
m.gen<-metabin(Cas_event,Cas_nevent,Con_event,Con_nevent,Author,m.data,method = "Peto",sm="OR",random = TRUE,fixed = TRUE,method.tau = "REML",allstudies = TRUE,incr = "TACC", backtransf = TRUE,title=model.name)
img_height<-nrow(m.data)*20+205
}else{
m.gen<-metabin(Cas_event,Cas_nevent,Con_event,Con_nevent,Author,m.data,method = "Peto",sm="OR",random = TRUE,fixed = TRUE,method.tau = "REML",allstudies = TRUE,incr = "TACC",subgroup = Ethnicity, backtransf = FALSE,title=model.name)
img_height<-nrow(m.data)*20+355
}
#  png(file = paste(savepath,"/","S",sup_ind,", ",model.name,"_Forest.png",sep = ""), width = 900, height = img_height)
# #
forest.meta(m.gen,prediction = TRUE, subgroup.name ="",colgap.forest.left = unit(2,"cm"),colgap.left = unit(0.5,"cm"),
col.by ="#CA2B30",Col.diamond = "#083D77", col.diamond.lines = "#251101",col.square = "#083D77",spacing = 1.2,
leftlabs = c("Study","Event","Total","Event","Total","Quality"),leftcols =c("studlab", "event.e", "n.e", "event.c", "n.c", "Quality"),
label.e = "Case",hetstats="random",print.Q = TRUE,print.pval.Q = TRUE,study.results = TRUE)
#dev.off()
mod_ind<-mod_ind+1
sup_ind<-sup_ind+1
}
mod_ind<-1
sub_ind<-sub_ind+1
}
